{
  "name": "pi-orchestrator",
  "version": "0.1.0",
  "description": "Evidence-driven workflow orchestration for Pi with Human Gates, durable artifacts, bounded retries, and Jev decisions.",
  "files": [
    "src",
    "agents",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "pi-subagents": {
    "agents": [
      "./agents"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "keywords": [
    "pi-package"
  ],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@types/node": "26.6.2",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "pi-typesafe": "^0.7.4"
  }
}
